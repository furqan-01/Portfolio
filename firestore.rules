rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio content can be read by any visitor; writes allowed for valid portfolio structure
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if request.auth != null || (request.resource.data.profile is map && request.resource.data.profile.name is string);
    }

    // Inbound contact messages can be created by visitors; reading and management permitted
    match /messages/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
